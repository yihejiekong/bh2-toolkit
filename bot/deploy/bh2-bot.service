[Unit]
Description=BH2 NoneBot QQ bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/bh2-bot
Environment=MATERIAL_ROOT=/opt/bh2-bot/materials
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/bh2-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
