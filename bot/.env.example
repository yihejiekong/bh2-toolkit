# 环境变量示例
# 复制成 .env 后按需填写；.env 已在 .gitignore 里，不要提交。

# ---- NoneBot 基础 ----
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# 反向 WS 鉴权 token：NapCat 那边也要填一样的
ACCESS_TOKEN=change-me

# 命令前缀置空：让「查询装备 轰击晨星」直接触发，不需要 /
COMMAND_START=[""]
COMMAND_SEP=[" "]

# ---- 素材与数据 ----
# 素材根目录（装备卡 / 立绘 / 图标 / 精英技能 / 僵尸娘 …）
MATERIAL_ROOT=./materials
# 玩家名片查询服务（bh2-query）的地址
BH2_QUERY_API=http://127.0.0.1:8791
# 区服参数文件（见 docs/05-玩家名片协议.md）
BH2_SERVERS=./servers.json

# ---- 管理员 ----
# 逗号分隔的 QQ 号；这些账号可以改固定回复、开关功能、不受抽老婆次数限制
BOT_ADMINS=

# ---- 推送类功能 ----
# B 站 Cookie（可选）：留空则走 RSSHub 兜底，匿名接口可能 412
BILI_COOKIE=
# 只推送多少小时内发布的内容，防止把旧动态当新动态
ANNOUNCE_FRESH_HOURS=24
NEWS_FRESH_HOURS=72
# 启动自检：true 时启动后立刻跑一次检查
ANNOUNCE_SELFTEST=false
NEWS_SELFTEST=false
